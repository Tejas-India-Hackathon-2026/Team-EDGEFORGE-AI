# GhoomoBihar — Environment Configuration
# Add your Groq API Key in Netlify Site Settings > Environment Variables
# or in a local .env file for local netlify dev

GROQ_API_KEY=gsk_your_groq_api_key_here

# Admin authentication values must be generated locally. Never commit real values.
ADMIN_USER_ID_HASH=sha256_hex_of_admin_user_id
ADMIN_PASSWORD_SALT=random_base64url_salt
ADMIN_PASSWORD_HASH=scrypt_base64url_hash
ADMIN_SESSION_SECRET=random_base64url_signing_key
ADMIN_ALLOWED_ORIGINS=https://ghoomobihar.netlify.app
